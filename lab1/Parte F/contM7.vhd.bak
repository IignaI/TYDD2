library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity contador_mod7 is
    Port (
        clk   : in  std_logic;
        reset : in  std_logic;
        Q     : out std_logic_vector(2 downto 0);
        findir   : out std_logic
    );
end entity;

architecture rtl of contador_mod7 is
    signal count : unsigned(2 downto 0) := (others => '0');
begin
    process(clk, reset)
    begin
        if reset = '1' then
            count <= (others => '0');
        elsif rising_edge(clk) then
            if count = 6 then      
                count <= (others => '0'); 
            else
                count <= count + 1;
            end if;
        end if;
    end process;

    Q <= std_logic_vector(count);

    findir <= '1' when count = 6 else '0';

end architecture;