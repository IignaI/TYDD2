initial 

begin 
$timeformat(-12,3," ps",6);
#2000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module i2c_comp_vlg_vec_tst();
// constants                                           
// general purpose registers
reg B1;
reg B2;
reg B3;
reg B4;
reg B5;
reg B6;
reg B7;
reg rst;
reg scl;
reg treg_sda;
// wires                                               
wire A1;
wire A2;
wire A3;
wire A4;
wire A5;
wire A6;
wire A7;
wire [2:0] C7;
wire [3:0] C8;
wire E1;
wire E2;
wire E3;
wire ffin_dir;
wire HAB_DAT;
wire HAB_DIR;
wire q0;
wire q1;
wire q2;
wire q3;
wire q4;
wire q5;
wire q6;
wire q7;
wire sda;
wire ssoy;

wire sampler;                             

// assign statements (if any)                          
assign sda = treg_sda;
i2c_comp i1 (
// port map - connection between master ports and signals/registers   
	.A1(A1),
	.A2(A2),
	.A3(A3),
	.A4(A4),
	.A5(A5),
	.A6(A6),
	.A7(A7),
	.B1(B1),
	.B2(B2),
	.B3(B3),
	.B4(B4),
	.B5(B5),
	.B6(B6),
	.B7(B7),
	.C7(C7),
	.C8(C8),
	.E1(E1),
	.E2(E2),
	.E3(E3),
	.ffin_dir(ffin_dir),
	.HAB_DAT(HAB_DAT),
	.HAB_DIR(HAB_DIR),
	.q0(q0),
	.q1(q1),
	.q2(q2),
	.q3(q3),
	.q4(q4),
	.q5(q5),
	.q6(q6),
	.q7(q7),
	.rst(rst),
	.scl(scl),
	.sda(sda),
	.ssoy(ssoy)
);

// rst
initial
begin
	rst = 1'b1;
	rst = #10000 1'b0;
end 

// scl
initial
begin
	repeat(19)
	begin
		scl = 1'b0;
		scl = #25000 1'b1;
		# 25000;
	end
	scl = 1'b0;
	scl = #25000 1'b1;
	scl = #24000 1'b0;
end 

// sda
initial
begin
	treg_sda = 1'b0;
	treg_sda = #30000 1'b1;
	treg_sda = #20000 1'b0;
	treg_sda = #30000 1'b1;
	treg_sda = #400000 1'b0;
	treg_sda = #90000 1'b1;
	treg_sda = #90000 1'b0;
end 

// B1
initial
begin
	B1 = 1'b1;
	B1 = #999000 1'b0;
end 

// B2
initial
begin
	B2 = 1'b1;
	B2 = #999000 1'b0;
end 

// B3
initial
begin
	B3 = 1'b1;
	B3 = #999000 1'b0;
end 

// B4
initial
begin
	B4 = 1'b1;
	B4 = #999000 1'b0;
end 

// B5
initial
begin
	B5 = 1'b1;
	B5 = #999000 1'b0;
end 

// B6
initial
begin
	B6 = 1'b1;
	B6 = #999000 1'b0;
end 

// B7
initial
begin
	B7 = 1'b0;
end 

i2c_comp_vlg_sample_tst tb_sample (
	.B1(B1),
	.B2(B2),
	.B3(B3),
	.B4(B4),
	.B5(B5),
	.B6(B6),
	.B7(B7),
	.rst(rst),
	.scl(scl),
	.sda(sda),
	.sampler_tx(sampler)
);

i2c_comp_vlg_check_tst tb_out(
	.A1(A1),
	.A2(A2),
	.A3(A3),
	.A4(A4),
	.A5(A5),
	.A6(A6),
	.A7(A7),
	.C7(C7),
	.C8(C8),
	.E1(E1),
	.E2(E2),
	.E3(E3),
	.ffin_dir(ffin_dir),
	.HAB_DAT(HAB_DAT),
	.HAB_DIR(HAB_DIR),
	.q0(q0),
	.q1(q1),
	.q2(q2),
	.q3(q3),
	.q4(q4),
	.q5(q5),
	.q6(q6),
	.q7(q7),
	.sda(sda),
	.ssoy(ssoy),
	.sampler_rx(sampler)
);
endmodule

