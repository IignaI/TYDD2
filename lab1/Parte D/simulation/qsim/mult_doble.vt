// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "10/28/2025 20:53:36"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    mult_doble
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module mult_doble_vlg_sample_tst(
	A0,
	A1,
	B0,
	B1,
	sampler_tx
);
input  A0;
input  A1;
input  B0;
input  B1;
output sampler_tx;

reg sample;
time current_time;
always @(A0 or A1 or B0 or B1)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module mult_doble_vlg_check_tst (
	r0_s,
	r0_us,
	r1_s,
	r1_us,
	r2_s,
	r2_us,
	r3_s,
	r3_us,
	sampler_rx
);
input  r0_s;
input  r0_us;
input  r1_s;
input  r1_us;
input  r2_s;
input  r2_us;
input  r3_s;
input  r3_us;
input sampler_rx;

reg  r0_s_expected;
reg  r0_us_expected;
reg  r1_s_expected;
reg  r1_us_expected;
reg  r2_s_expected;
reg  r2_us_expected;
reg  r3_s_expected;
reg  r3_us_expected;

reg  r0_s_prev;
reg  r0_us_prev;
reg  r1_s_prev;
reg  r1_us_prev;
reg  r2_s_prev;
reg  r2_us_prev;
reg  r3_s_prev;
reg  r3_us_prev;

reg  r0_s_expected_prev;
reg  r0_us_expected_prev;
reg  r1_s_expected_prev;
reg  r1_us_expected_prev;
reg  r2_s_expected_prev;
reg  r2_us_expected_prev;
reg  r3_s_expected_prev;
reg  r3_us_expected_prev;

reg  last_r0_s_exp;
reg  last_r0_us_exp;
reg  last_r1_s_exp;
reg  last_r1_us_exp;
reg  last_r2_s_exp;
reg  last_r2_us_exp;
reg  last_r3_s_exp;
reg  last_r3_us_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:8] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 8'b1;
end

// update real /o prevs

always @(trigger)
begin
	r0_s_prev = r0_s;
	r0_us_prev = r0_us;
	r1_s_prev = r1_s;
	r1_us_prev = r1_us;
	r2_s_prev = r2_s;
	r2_us_prev = r2_us;
	r3_s_prev = r3_s;
	r3_us_prev = r3_us;
end

// update expected /o prevs

always @(trigger)
begin
	r0_s_expected_prev = r0_s_expected;
	r0_us_expected_prev = r0_us_expected;
	r1_s_expected_prev = r1_s_expected;
	r1_us_expected_prev = r1_us_expected;
	r2_s_expected_prev = r2_s_expected;
	r2_us_expected_prev = r2_us_expected;
	r3_s_expected_prev = r3_s_expected;
	r3_us_expected_prev = r3_us_expected;
end



// expected r3_s
initial
begin
	r3_s_expected = 1'bX;
end 

// expected r2_s
initial
begin
	r2_s_expected = 1'bX;
end 

// expected r1_s
initial
begin
	r1_s_expected = 1'bX;
end 

// expected r0_s
initial
begin
	r0_s_expected = 1'bX;
end 

// expected r3_us
initial
begin
	r3_us_expected = 1'bX;
end 

// expected r2_us
initial
begin
	r2_us_expected = 1'bX;
end 

// expected r1_us
initial
begin
	r1_us_expected = 1'bX;
end 

// expected r0_us
initial
begin
	r0_us_expected = 1'bX;
end 
// generate trigger
always @(r0_s_expected or r0_s or r0_us_expected or r0_us or r1_s_expected or r1_s or r1_us_expected or r1_us or r2_s_expected or r2_s or r2_us_expected or r2_us or r3_s_expected or r3_s or r3_us_expected or r3_us)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected r0_s = %b | expected r0_us = %b | expected r1_s = %b | expected r1_us = %b | expected r2_s = %b | expected r2_us = %b | expected r3_s = %b | expected r3_us = %b | ",r0_s_expected_prev,r0_us_expected_prev,r1_s_expected_prev,r1_us_expected_prev,r2_s_expected_prev,r2_us_expected_prev,r3_s_expected_prev,r3_us_expected_prev);
	$display("| real r0_s = %b | real r0_us = %b | real r1_s = %b | real r1_us = %b | real r2_s = %b | real r2_us = %b | real r3_s = %b | real r3_us = %b | ",r0_s_prev,r0_us_prev,r1_s_prev,r1_us_prev,r2_s_prev,r2_us_prev,r3_s_prev,r3_us_prev);
`endif
	if (
		( r0_s_expected_prev !== 1'bx ) && ( r0_s_prev !== r0_s_expected_prev )
		&& ((r0_s_expected_prev !== last_r0_s_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port r0_s :: @time = %t",  $realtime);
		$display ("     Expected value = %b", r0_s_expected_prev);
		$display ("     Real value = %b", r0_s_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_r0_s_exp = r0_s_expected_prev;
	end
	if (
		( r0_us_expected_prev !== 1'bx ) && ( r0_us_prev !== r0_us_expected_prev )
		&& ((r0_us_expected_prev !== last_r0_us_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port r0_us :: @time = %t",  $realtime);
		$display ("     Expected value = %b", r0_us_expected_prev);
		$display ("     Real value = %b", r0_us_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_r0_us_exp = r0_us_expected_prev;
	end
	if (
		( r1_s_expected_prev !== 1'bx ) && ( r1_s_prev !== r1_s_expected_prev )
		&& ((r1_s_expected_prev !== last_r1_s_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port r1_s :: @time = %t",  $realtime);
		$display ("     Expected value = %b", r1_s_expected_prev);
		$display ("     Real value = %b", r1_s_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_r1_s_exp = r1_s_expected_prev;
	end
	if (
		( r1_us_expected_prev !== 1'bx ) && ( r1_us_prev !== r1_us_expected_prev )
		&& ((r1_us_expected_prev !== last_r1_us_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port r1_us :: @time = %t",  $realtime);
		$display ("     Expected value = %b", r1_us_expected_prev);
		$display ("     Real value = %b", r1_us_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_r1_us_exp = r1_us_expected_prev;
	end
	if (
		( r2_s_expected_prev !== 1'bx ) && ( r2_s_prev !== r2_s_expected_prev )
		&& ((r2_s_expected_prev !== last_r2_s_exp) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port r2_s :: @time = %t",  $realtime);
		$display ("     Expected value = %b", r2_s_expected_prev);
		$display ("     Real value = %b", r2_s_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_r2_s_exp = r2_s_expected_prev;
	end
	if (
		( r2_us_expected_prev !== 1'bx ) && ( r2_us_prev !== r2_us_expected_prev )
		&& ((r2_us_expected_prev !== last_r2_us_exp) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port r2_us :: @time = %t",  $realtime);
		$display ("     Expected value = %b", r2_us_expected_prev);
		$display ("     Real value = %b", r2_us_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_r2_us_exp = r2_us_expected_prev;
	end
	if (
		( r3_s_expected_prev !== 1'bx ) && ( r3_s_prev !== r3_s_expected_prev )
		&& ((r3_s_expected_prev !== last_r3_s_exp) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port r3_s :: @time = %t",  $realtime);
		$display ("     Expected value = %b", r3_s_expected_prev);
		$display ("     Real value = %b", r3_s_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_r3_s_exp = r3_s_expected_prev;
	end
	if (
		( r3_us_expected_prev !== 1'bx ) && ( r3_us_prev !== r3_us_expected_prev )
		&& ((r3_us_expected_prev !== last_r3_us_exp) ||
			on_first_change[8])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port r3_us :: @time = %t",  $realtime);
		$display ("     Expected value = %b", r3_us_expected_prev);
		$display ("     Real value = %b", r3_us_prev);
		nummismatches = nummismatches + 1;
		on_first_change[8] = 1'b0;
		last_r3_us_exp = r3_us_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module mult_doble_vlg_vec_tst();
// constants                                           
// general purpose registers
reg A0;
reg A1;
reg B0;
reg B1;
// wires                                               
wire r0_s;
wire r0_us;
wire r1_s;
wire r1_us;
wire r2_s;
wire r2_us;
wire r3_s;
wire r3_us;

wire sampler;                             

// assign statements (if any)                          
mult_doble i1 (
// port map - connection between master ports and signals/registers   
	.A0(A0),
	.A1(A1),
	.B0(B0),
	.B1(B1),
	.r0_s(r0_s),
	.r0_us(r0_us),
	.r1_s(r1_s),
	.r1_us(r1_us),
	.r2_s(r2_s),
	.r2_us(r2_us),
	.r3_s(r3_s),
	.r3_us(r3_us)
);

// A1
always
begin
	A1 = 1'b0;
	A1 = #50000 1'b1;
	#50000;
end 

// A0
always
begin
	A0 = 1'b0;
	A0 = #25000 1'b1;
	#25000;
end 

// B1
initial
begin
	B1 = 1'b0;
	B1 = #50000 1'b1;
	B1 = #50000 1'b0;
	B1 = #50000 1'b1;
	B1 = #100000 1'b0;
	B1 = #100000 1'b1;
	B1 = #50000 1'b0;
	B1 = #50000 1'b1;
	B1 = #50000 1'b0;
	B1 = #50000 1'b1;
	B1 = #50000 1'b0;
	B1 = #50000 1'b1;
	B1 = #100000 1'b0;
	B1 = #100000 1'b1;
	B1 = #50000 1'b0;
end 

// B0
initial
begin
	B0 = 1'b1;
	B0 = #25000 1'b0;
	B0 = #50000 1'b1;
	B0 = #50000 1'b0;
	B0 = #25000 1'b1;
	B0 = #50000 1'b0;
	B0 = #100000 1'b1;
	B0 = #50000 1'b0;
	B0 = #100000 1'b1;
	B0 = #50000 1'b0;
	B0 = #25000 1'b1;
	B0 = #50000 1'b0;
	B0 = #25000 1'b1;
	B0 = #25000 1'b0;
	B0 = #25000 1'b1;
	B0 = #25000 1'b0;
	B0 = #50000 1'b1;
	B0 = #75000 1'b0;
	B0 = #25000 1'b1;
	B0 = #25000 1'b0;
	B0 = #25000 1'b1;
	B0 = #50000 1'b0;
end 

mult_doble_vlg_sample_tst tb_sample (
	.A0(A0),
	.A1(A1),
	.B0(B0),
	.B1(B1),
	.sampler_tx(sampler)
);

mult_doble_vlg_check_tst tb_out(
	.r0_s(r0_s),
	.r0_us(r0_us),
	.r1_s(r1_s),
	.r1_us(r1_us),
	.r2_s(r2_s),
	.r2_us(r2_us),
	.r3_s(r3_s),
	.r3_us(r3_us),
	.sampler_rx(sampler)
);
endmodule

